  "global_method": {
    "sample_period": "2005-04-29-2016-12-30",
    "backtest_result_period": "2005-05-09-2016-12-30",
    "universe": "All A-shares; exclude ST/PT stocks and stocks suspended on the next trading day of each cross-sectional date.",
    "frequency": "month",
    "cross_section_timing": "Compute factor exposure on the last trading day of each calendar month.",
    "return_target": "Next calendar month's individual stock excess return relative to CSI 300.",
    "data_source": "Wind",
    "benchmark": "CSI 300",
    "industry_classification": "CITIC first-level industry, inferred from the paper's 29 first-level industry tables.",
    "formula_evidence": [
      {
        "source_location": "Figure/Table 1",
        "description": "Turnover factor list and definitions for turn_Nm, std_turn_Nm, and bias_std_turn_Nm."
      },
      {
        "source_location": "Pages 11-13",
        "description": "Common regression, IC, preprocessing, and layered backtest methodology."
      },
      {
        "source_location": "Figures/Tables 106, 111, 125, 127",
        "description": "Summary evaluation metrics for regression, IC, and layered backtest results."
      }
    ],
    "known_limitations": [
      "Aggregate evaluation metrics are available; per-date factor values, IC series, regression coefficient series, and portfolio NAV series are shown only as charts or summary tables.",
      "The paper states first-level industries but the extracted text does not explicitly name the industry taxonomy; CITIC first-level industry is inferred from the 29 industry labels used by Huatai.",
      "The report uses calendar-month timing and 1m/3m lookbacks; exact trading-day counts for month windows are not separately enumerated."
    ]
  },
  "transform_definitions": {
    "regression_wls_preprocessed": {
      "description": "Transform used before monthly WLS cross-sectional regression.",
      "steps": [
        {
          "name": "winsorization",
          "method": "median_mad",
          "threshold": 5,
          "source": "explicit",
          "source_location": "Page 11, data processing method b"
        },
        {
          "name": "standardization",
          "method": "cross_section_zscore",
          "source": "explicit",
          "source_location": "Page 11, data processing method c"
        },
        {
          "name": "missing_value_policy",
          "method": "fill_missing_with_zero_after_standardization",
          "interpretation": "After z-score standardization, missing exposures are set to the standardized series mean, i.e. zero.",
          "source": "explicit",
          "source_location": "Pages 11-12, data processing method d"
        },
        {
          "name": "regression_controls",
          "method": "include_industry_dummies_in_return_regression",
          "controls": [
            "industry"
          ],
          "source": "explicit",
          "source_location": "Page 11 regression model and notes"
        },
        {
          "name": "regression_weighting",
          "method": "weighted_least_squares",
          "weight": "sqrt_free_float_market_cap",
          "source": "explicit",
          "source_location": "Page 12, regression weight"
        }
      ]
    },
    "ic_size_industry_adjusted": {
      "description": "Transform used before monthly IC calculation: preprocess factor exposure, neutralize against size and industry, then correlate residuals with next-month stock returns.",
      "steps": [
        {
          "name": "winsorization",
          "method": "median_mad",
          "threshold": 5,
          "source": "inferred_from_ic_method_same_as_regression",
          "source_location": "Page 12, IC method item 1-2"
        },
        {
          "name": "standardization",
          "method": "cross_section_zscore",
          "source": "inferred_from_ic_method_same_as_regression",
          "source_location": "Page 12, IC method item 1-2"
        },
        {
          "name": "missing_value_policy",
          "method": "fill_missing_with_zero_after_standardization",
          "source": "inferred_from_ic_method_same_as_regression",
          "source_location": "Page 12, IC method item 1-2"
        },
        {
          "name": "neutralization",
          "method": "cross_sectional_regression_residual",
          "controls": [
            "market_cap",
            "industry"
          ],
          "source": "explicit",
          "source_location": "Page 12, IC method item 2"
        }
      ]
    },
    "layered_backtest_raw": {
      "description": "Transform used for layered portfolio backtests. The paper explicitly does not process factor values for layering; stocks with missing factor values are excluded.",
      "steps": [
        {
          "name": "preprocessing",
          "method": "none",
          "source": "explicit",
          "source_location": "Page 13, layered backtest method item 3"
        },
        {
          "name": "missing_value_policy",
          "method": "exclude_missing_factor_values",
          "source": "explicit",
          "source_location": "Page 13, layered backtest method item 3"
        },
        {
          "name": "sorting",
          "method": "ascending_by_factor_within_each_first_level_industry",
          "source": "explicit",
          "source_location": "Page 13, layered backtest method item 4; Page 14 layered result explanation item 1"
        },
        {
          "name": "industry_neutral_weighting",
          "method": "industry_weights_match_csi300",
          "within_industry_weighting": "equal_weight",
          "source": "explicit",
          "source_location": "Page 13, layered backtest method item 4"
        }
      ]
    }
  },
  "evaluation_method_definitions": {
    "wls_regression": {
      "description": "Monthly cross-sectional WLS regression of next calendar month's stock excess return on the tested factor and industry dummy variables.",
      "metrics": [
        "t_abs_mean",
        "t_abs_gt_2_ratio",
        "t_mean",
        "t_mean_over_t_std",
        "factor_return_mean",
        "factor_return_series_t_stat"
      ],
      "default_spec": {
        "cross_section_frequency": "month",
        "return_horizon": 1,
        "return_horizon_unit": "calendar_month",
        "return_type": "excess_return_relative_to_csi300",
        "regression_model": "weighted_least_squares",
        "regression_weight": "sqrt_free_float_market_cap",
        "controls": [
          "industry"
        ]
      }
    },
    "ols_regression": {
      "description": "Monthly cross-sectional OLS regression used as a comparison against WLS in the paper.",
      "metrics": [
        "t_abs_mean",
        "t_abs_gt_2_ratio",
        "t_mean",
        "t_mean_over_t_std",
        "factor_return_mean",
        "factor_return_series_t_stat"
      ],
      "default_spec": {
        "cross_section_frequency": "month",
        "return_horizon": 1,
        "return_horizon_unit": "calendar_month",
        "return_type": "excess_return_relative_to_csi300",
        "regression_model": "ordinary_least_squares",
        "controls": [
          "industry"
        ]
      }
    },
    "ic_analysis": {
      "description": "Monthly IC analysis after size and industry adjustment of factor exposure.",
      "metrics": [
        "ic_mean",
        "ic_std",
        "ic_ir_abs",
        "ic_positive_ratio",
        "ic_abs_gt_0_02_ratio"
      ],
      "default_spec": {
        "cross_section_frequency": "month",
        "return_horizon": 1,
        "return_horizon_unit": "calendar_month",
        "return_type": "next_month_stock_return",
        "ic_type": "pearson_correlation",
        "factor_transform": "size_and_industry_adjusted_residual"
      }
    },
    "layered_portfolio_backtest": {
      "description": "Industry-neutral monthly layered portfolio backtest. Main detailed factor tables use five layers; annual rank tables and size-bucket charts use ten layers.",
      "metrics": [
        "top_layer_annual_return",
        "top_layer_annual_volatility",
        "top_layer_sharpe",
        "top_layer_max_drawdown",
        "top_layer_excess_return",
        "top_layer_excess_volatility",
        "top_layer_information_ratio",
        "top_layer_benchmark_month_win_rate",
        "top_layer_excess_max_drawdown",
        "long_short_annual_return",
        "long_short_sharpe",
        "long_short_max_drawdown",
        "long_short_month_win_rate",
        "monotonicity_score"
      ],
      "default_spec": {
        "rebalance_frequency": "month",
        "factor_observation_timing": "last_trading_day_of_calendar_month",
        "execution_timing": "first_trading_day_of_next_calendar_month",
        "execution_price": "close",
        "n_groups_main": 5,
        "n_groups_monotonicity": 10,
        "sort_order": "ascending",
        "top_group": 1,
        "bottom_group": 5,
        "long_short_portfolio": "long_group_1_short_group_5",
        "benchmark": "CSI 300",
        "industry_neutral": true,
        "industry_weights": "match_csi300",
        "within_industry_weighting": "equal_weight"
      }
    },
    "parameter_sensitivity": {
      "description": "Sensitivity tests over shorter day-count windows for turnover-related factor families.",
      "metrics": [
        "t_abs_mean",
        "t_abs_gt_2_ratio",
        "t_mean_over_t_std",
        "factor_return_mean",
        "factor_return_series_t_stat",
        "ic_mean",
        "ic_std",
        "ic_ir_abs",
        "ic_positive_ratio",
        "top_layer_annual_return",
        "top_layer_sharpe",
        "top_layer_information_ratio",
        "top_layer_max_drawdown",
        "top_layer_benchmark_month_win_rate",
        "long_short_annual_return",
        "long_short_sharpe",
        "long_short_max_drawdown",
        "long_short_month_win_rate",
        "monotonicity_score"
      ],
      "default_spec": {
        "window_candidates": [
