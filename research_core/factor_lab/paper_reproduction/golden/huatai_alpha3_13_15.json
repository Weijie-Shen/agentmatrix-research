  "transform_definitions": {
    "raw_or_unprocessed": {
      "description": "No explicit factor neutralization. Huatai labels this as 因子不中性化; winsorization/standardization may still be inferred from the global method and should be reviewed before numeric reproduction.",
      "steps": [
        {
          "name": "winsorization",
          "method": "median_mad",
          "threshold": 5,
          "source": "inferred_from_global_method",
          "source_location": "Page 11 b"
        },
        {
          "name": "neutralization",
          "method": "none",
          "source": "explicit",
          "source_location": "table treatment label 因子不中性化"
        },
        {
          "name": "standardization",
          "method": "cross_section_zscore",
          "source": "inferred_from_global_method",
          "source_location": "Page 11 d"
        },
        {
          "name": "missing_value_policy",
          "method": "do_not_fill",
          "source": "explicit",
          "source_location": "Page 11 e"
        }
      ]
    },
    "industry_market_cap_neutralized": {
      "description": "Median-MAD winsorization, cross-sectional regression residualization against industry dummies and log market-cap, then cross-sectional z-score standardization.",
      "steps": [
        {
          "name": "winsorization",
          "method": "median_mad",
          "threshold": 5,
          "source": "explicit",
          "source_location": "Page 11 b"
        },
        {
          "name": "neutralization",
          "method": "cross_sectional_regression_residual",
          "controls": [
            "industry",
            "log_market_cap"
          ],
          "source": "explicit",
          "source_location": "Page 11 c; Table 52 selected rows"
        },
        {
          "name": "standardization",
          "method": "cross_section_zscore",
          "source": "explicit",
          "source_location": "Page 11 d"
        },
        {
          "name": "missing_value_policy",
          "method": "do_not_fill",
          "source": "explicit",
          "source_location": "Page 11 e"
        }
      ]
    },
    "ordered_orthogonalized": {
      "description": "Sequential orthogonalization of selected Alpha factors according to Table 9 ranking before IC/regression evaluation.",
      "steps": [
        {
          "name": "winsorization",
          "method": "median_mad",
          "threshold": 5,
          "source": "inferred_from_global_method"
        },
        {
          "name": "neutralization",
          "method": "sequential_regression_residual",
          "controls": [
            "industry",
            "log_market_cap",
            "previous_selected_alpha_factors"
          ],
          "source": "explicit",
          "source_location": "Page 33 before Table 52"
        },
        {
          "name": "standardization",
          "method": "cross_section_zscore",
          "source": "inferred_from_global_method"
        }
      ]
    }
  },
  "evaluation_method_definitions": {
    "ic_regression": {
      "description": "Daily cross-sectional regression and Rank IC analysis. Horizons 5, 10, 20 trading days are studied; this golden file uses T=20 cases.",
      "metrics": [
        "t_abs_mean",
        "t_abs_gt_2_ratio",
        "t_mean",
        "factor_return_mean",
        "rank_ic_mean",
        "rank_ic_std",
        "ic_ir",
        "ic_positive_ratio"
      ],
      "default_spec": {
        "return_horizon": 20,
        "return_horizon_unit": "trading_day",
        "ic_type": "spearman_rank_ic"
      }
    },
    "ic_decay": {
      "description": "Rank IC decay/half-life analysis over lagged forward-return windows for selected factors.",
      "metrics": [
        "half_life_exp_fit_days",
        "half_life_observed_days"
      ],
      "default_spec": {
        "base_return_horizon": 20,
        "lag_range": [
          0,
          240
        ],
        "ic_type": "spearman_rank_ic"
      }
    },
    "layered_portfolio_backtest": {
      "description": "20 equal-count layer backtest and selected TOP layer portfolio metrics.",
      "metrics": [
        "top_layer_annual_return",
        "top_layer_sharpe",
        "top_layer_max_drawdown",
        "top_layer_excess_return",
        "top_layer_information_ratio",
        "annual_two_way_turnover"
      ],
      "default_spec": {
        "n_groups": 20,
        "sort_order": "descending",
        "top_group": 1,
        "rebalance_horizon": 20,
        "one_way_fee": 0.0015,
        "weighting": "equal_weight"
      }
    }
  },
  "comparison_policy": {
    "strict_fields": [
      "factor_name",
      "formula_definition.formula",
      "formula_definition.formula_required_fields",
      "formula_definition.parameters",
      "evaluation_cases.paper_truth.metrics"
    ],
    "semantic_fields": [
      "universe",
      "sample_period",
      "evaluation_cases.evaluation_spec",
      "evaluation_cases.transform_spec_id",
      "evaluation_cases.required_data"
    ],
    "truth_source_rules": [
      "Each evaluation case should correspond to one source table/figure and one evaluation setting.",
      "Do not combine Table 52 IC/regression, Table 14 decay, and TOP portfolio metrics into one case."
    ]
  },
